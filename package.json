{
  "name": "drdp",
  "version": "1.0.0",
  "description": "YID Due Ledger — secure full-stack web app for member dues tracking",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "cd frontend && npm install && npm run build",
    "build:frontend": "cd frontend && npm install && npm run build",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy": "firebase deploy",
    "deploy:indexes": "npx --yes firebase-tools deploy --only firestore:indexes",
    "init:functions": "cd functions && npm install",
    "scripts:preflight": "node scripts/preflight-check.js",
    "scripts:verify": "node scripts/verify-queries.js",
    "scripts:create-indexes": "node scripts/create-indexes.js",
    "scripts:preview": "node scripts/preview-check.js",
    "indexes:list": "npx --yes firebase-tools firestore:indexes"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^14.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  }
}
