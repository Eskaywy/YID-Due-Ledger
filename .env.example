# ── Server ──────────────────────────────────────────────────────
# Port the Express server listens on (local dev only; Cloud Functions ignores)
PORT=3001

# JWT signing key — **CHANGE THIS IN PRODUCTION!**
JWT_SECRET=change-this-to-a-long-random-string-in-production

# CORS: the domain(s) your frontend is served from.
#   Local dev:    http://localhost:5173
#   Firebase prod: your-site.web.app  (or custom domain)
CLIENT_URL=http://localhost:5173

# Node environment (set to "production" for self-hosted deployments)
NODE_ENV=production

# ── Firebase ────────────────────────────────────────────────────
# When running locally, the service-account key is loaded from
# serviceAccountKey.json (NOT committed — keep it secret).
# In Cloud Functions / Cloud Run, Application Default Credentials
# are used automatically — no key file needed.
#
# serviceAccountKey.json  →  download from Firebase Console → Project Settings
