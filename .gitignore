.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
server.log

# Script output files
preview-check.txt

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Stale dev artifacts
data/*.db
data/*.sqlite

# Supabase service role key must NEVER be committed — it lives in env vars only

